<Project>
	<!--
	Some submodules (e.g. SukiUI) set GeneratePackageOnBuild=true, and packing fails on a fresh
	clone (NU5046, icon not found). We consume them as project references, never as .nupkg,
	so skip packing. (Directory.Build.targets is evaluated after the csproj, so this wins.)
	-->
	<PropertyGroup>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>


	<!--
	LSLibStats intentionally excludes its own GplexBuffers.cs / ShiftReduceParserCode.cs so it uses the
	public QUT.Gppg / QUT.GplexBuffers runtime exported by LSLib. However, the YaccLexTools targets
	re-add those files to @(Compile) whenever they regenerate the parsers, which always happens on a
	fresh clone (e.g. CI), producing duplicate internal types and CS0053/CS0311 errors.
	Re-apply the exclusion after the generators run.
	-->
	<Target Name="BG3MM_ExcludeDuplicateParserRuntime"
			Condition="'$(MSBuildProjectName)' == 'LSLibStats'"
			AfterTargets="YaccLexToolsGplexSingleTarget;YaccLexToolsGppgSingleTarget"
			BeforeTargets="CoreCompile">
		<ItemGroup>
			<Compile Remove="GplexBuffers.cs;ShiftReduceParserCode.cs" />
		</ItemGroup>
	</Target>

	<!--
	Avalonia version for the whole build. 12.0.0-preview1's X11 backend had no XDND support (no drag and drop from Linux
	file managers); stable 12.1.x does. SukiUI (upstream, central package management) builds against 12.1.1 and
	MarkdownViewer.Core hard-codes 12.0.0-preview1; align both. Properties set here win over earlier ones (items are
	evaluated after all properties); PackageReference Update covers projects without central package management.
	-->
	<PropertyGroup>
		<AvaloniaVersion>12.1.6</AvaloniaVersion>
	</PropertyGroup>
	<ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
		<PackageReference Update="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Update="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<PackageReference Update="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Update="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
	</ItemGroup>
</Project>
