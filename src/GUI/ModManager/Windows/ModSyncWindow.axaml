<Window x:Class="ModManager.ModSyncWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:ModManager.ViewModels"
    Title="Mod Sync"
    Width="900"
    Height="680"
    MinWidth="640"
    MinHeight="480"
    x:DataType="vm:ModSyncWindowViewModel"
    Icon="avares://ModManager/Assets/BG3ModManager.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
	<Window.Styles>
		<!--  Note: avoid Opacity here; elements with Opacity < 1 currently don't render in this window (Avalonia 12 preview).  -->
		<Style Selector="TextBlock.hint">
			<Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,2,0,6" />
		</Style>
		<Style Selector="TextBlock.header">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Margin" Value="0,10,0,4" />
		</Style>
		<Style Selector="Button">
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
	</Window.Styles>
	<VisualLayerManager Name="PART_VisualLayerManager" IsHitTestVisible="True">
		<VisualLayerManager.ChromeOverlayLayer>
			<suki:SukiToastHost Name="ToastHost" MaxToasts="4" Position="BottomLeft" />
		</VisualLayerManager.ChromeOverlayLayer>
		<Panel>
			<suki:SukiBackground IsHitTestVisible="False" />
			<TabControl Margin="8">
				<!--  ============================ HOST ============================  -->
				<TabItem Header="Host">
					<ScrollViewer>
						<StackPanel Margin="8">
							<TextBlock Classes="hint" Text="Share your active mods and load order. Friends paste your invite code into the Join tab; they download straight from this PC, and only while you're hosting." />

							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock VerticalAlignment="Center" Text="Port (TCP)" />
								<NumericUpDown Width="140"
								    FormatString="0"
								    IsEnabled="{Binding !IsHosting}"
								    Maximum="65535"
								    Minimum="1024"
								    Value="{Binding Port}" />
								<CheckBox VerticalAlignment="Center"
								    Content="Open the port on my router automatically (UPnP / NAT-PMP)"
								    IsChecked="{Binding UseNatPortMapping}"
								    IsEnabled="{Binding !IsHosting}" />
							</StackPanel>

							<TextBlock Margin="0,8,0,0" Text="Extra addresses to include in invites (optional)" />
							<TextBox IsEnabled="{Binding !IsHosting}" Text="{Binding ExtraAddressesText}" Watermark="e.g. your public IP or a dynamic DNS name like myhome.duckdns.org, comma separated" />
							<TextBlock Classes="hint" Text="Use this if you forwarded the port by hand and the router didn't report your public IP, or if your IP changes and you use dynamic DNS." />

							<StackPanel Margin="0,8,0,0" Orientation="Horizontal">
								<Button Classes="Flat Accent" Command="{Binding StartHostingCommand}" Content="Start hosting" IsVisible="{Binding !IsHosting}" />
								<Button Command="{Binding StopHostingCommand}" Content="Stop hosting" IsVisible="{Binding IsHosting}" />
								<Button Command="{Binding RefreshSharedCommand}" IsVisible="{Binding IsHosting}" Content="Refresh shared mods" ToolTip.Tip="The shared list updates automatically when you change your active mods; use this after replacing pak files by hand." />
							</StackPanel>

							<TextBlock Margin="0,8,0,0" Text="{Binding HostStatus}" TextWrapping="Wrap" />
							<TextBlock Classes="hint" IsVisible="{Binding NatStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding NatStatus}" />
							<TextBlock Classes="hint" IsVisible="{Binding SharedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding SharedSummary}" />

							<TextBlock Classes="header" Text="Invite code" />
							<Grid ColumnDefinitions="*,Auto,Auto">
								<TextBox IsReadOnly="True"
								    PasswordChar="•"
								    RevealPassword="{Binding #RevealInvite.IsChecked}"
								    Text="{Binding InviteCode}"
								    Watermark="Start hosting to get an invite code" />
								<ToggleButton Name="RevealInvite"
								    Grid.Column="1"
								    Margin="6,0,0,0"
								    Content="Show" />
								<Button Grid.Column="2"
								    Margin="6,0,0,0"
								    Classes="Flat Accent"
								    Command="{Binding CopyInviteCommand}"
								    Content="Copy" />
							</Grid>
							<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
								<TextBlock Classes="hint" VerticalAlignment="Center" Text="Treat it like a password. If it leaks, " />
								<Button Padding="4,0" Command="{Binding RegenerateTokenCommand}" Content="generate a new one" />
								<TextBlock Classes="hint" VerticalAlignment="Center" Text="(old codes stop working)." />
							</StackPanel>

							<TextBlock Classes="header" Text="Addresses friends will try" />
							<TextBlock Classes="hint" Text="VPN addresses (e.g. OpenVPN tun0) work when your friends are on the same VPN. Internet addresses need the port forwarded on your router (automatic if UPnP worked)." />
							<ItemsControl ItemsSource="{Binding Addresses}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:SyncAddressRow">
										<Grid Margin="0,1" ColumnDefinitions="80,200,*">
											<TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
											<SelectableTextBlock Grid.Column="1" Text="{Binding Address}" />
											<TextBlock Grid.Column="2" Foreground="{DynamicResource SukiLowText}" Text="{Binding Source}" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<TextBlock Classes="header" Text="Activity" />
							<ListBox MaxHeight="180" ItemsSource="{Binding Activity}" />
						</StackPanel>
					</ScrollViewer>
				</TabItem>

				<!--  ============================ JOIN ============================  -->
				<TabItem Header="Join">
					<Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
						<TextBlock Classes="hint" Text="Paste the invite code your friend sent you, then Connect to see what will change before anything is downloaded." />
						<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
							<TextBox PasswordChar="•"
							    RevealPassword="{Binding #RevealJoinInvite.IsChecked}"
							    Text="{Binding InviteInput}"
							    Watermark="BG3SYNC1-..." />
							<ToggleButton Name="RevealJoinInvite"
							    Grid.Column="1"
							    Margin="6,0,0,0"
							    Content="Show" />
							<Button Grid.Column="2"
							    Margin="6,0,0,0"
							    Classes="Flat Accent"
							    Command="{Binding ConnectCommand}"
							    Content="Connect" />
						</Grid>
						<SelectableTextBlock Grid.Row="2"
						    Margin="0,8,0,0"
						    Text="{Binding JoinStatus}"
						    TextWrapping="Wrap" />
						<TextBlock Grid.Row="3"
						    Margin="0,6,0,4"
						    FontWeight="SemiBold"
						    Text="{Binding PlanSummary}"
						    TextWrapping="Wrap" />

						<ListBox Grid.Row="4" ItemsSource="{Binding PlanRows}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:SyncPlanRow">
									<Grid ColumnDefinitions="110,*,90">
										<TextBlock FontWeight="SemiBold"
										    Foreground="{Binding StatusColor}"
										    Text="{Binding Status}" />
										<StackPanel Grid.Column="1">
											<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
											<TextBlock FontSize="11"
											    Foreground="{DynamicResource SukiLowText}"
											    Text="{Binding FileName}"
											    TextTrimming="CharacterEllipsis" />
										</StackPanel>
										<TextBlock Grid.Column="2"
										    HorizontalAlignment="Right"
										    Text="{Binding Size}" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<StackPanel Grid.Row="5" Margin="0,8,0,0">
							<CheckBox Content="Move mods the host doesn't have into the backup folder (they're never deleted)" IsChecked="{Binding MoveExtrasToBackup}" />
							<CheckBox Content="Apply the host's load order (as a new order named 'Synced from ...')" IsChecked="{Binding ApplyLoadOrder}" />
							<CheckBox Margin="24,0,0,0"
							    Content="Export it to the game right away"
							    IsChecked="{Binding ExportToGame}"
							    IsEnabled="{Binding ApplyLoadOrder}" />
						</StackPanel>

						<StackPanel Grid.Row="6"
						    Margin="0,8,0,0"
						    IsVisible="{Binding IsSyncing}">
							<ProgressBar Height="8" Value="{Binding ProgressPercent}" />
							<TextBlock FontSize="12"
							    Text="{Binding ProgressText}"
							    TextTrimming="CharacterEllipsis" />
						</StackPanel>

						<StackPanel Grid.Row="7"
						    Margin="0,8,0,0"
						    Orientation="Horizontal">
							<Button Classes="Flat Accent" Command="{Binding SyncCommand}" Content="Sync now" IsVisible="{Binding HasPlan}" />
							<Button Command="{Binding CancelCommand}" Content="Cancel" />
							<Button Command="{Binding OpenBackupFolderCommand}" Content="Open backup folder" IsVisible="{Binding LastBackupFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
						</StackPanel>
					</Grid>
				</TabItem>
			</TabControl>
		</Panel>
	</VisualLayerManager>
</Window>
