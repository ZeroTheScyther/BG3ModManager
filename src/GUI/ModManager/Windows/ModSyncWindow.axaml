<Window x:Class="ModManager.ModSyncWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:vm="using:ModManager.ViewModels"
    Title="Mod Sync"
    Width="900"
    Height="680"
    MinWidth="640"
    MinHeight="480"
    x:DataType="vm:ModSyncWindowViewModel"
    Icon="avares://ModManager/Assets/BG3ModManager.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
	<Window.Styles>
		<!--  Note: avoid Opacity here; elements with Opacity < 1 currently don't render in this window (Avalonia 12 preview).  -->
		<Style Selector="TextBlock.hint">
			<Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,2,0,6" />
		</Style>
		<Style Selector="TextBlock.header">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Margin" Value="0,10,0,4" />
		</Style>
		<Style Selector="Button">
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
	</Window.Styles>
	<VisualLayerManager Name="PART_VisualLayerManager" IsHitTestVisible="True">
		<!--  Avalonia 12 removed VisualLayerManager.ChromeOverlayLayer; overlay hosts sit on top of the content instead.  -->
		<Panel>
			<Panel>
				<suki:SukiBackground IsHitTestVisible="False" />
				<TabControl Margin="8">
					<!--  ============================ HOST ============================  -->
					<TabItem Header="Host">
						<ScrollViewer>
							<StackPanel Margin="8">

								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock VerticalAlignment="Center" Text="Port (TCP)" />
									<NumericUpDown Width="140"
									    FormatString="0"
									    IsEnabled="{Binding !IsHosting}"
									    Maximum="65535"
									    Minimum="1024"
									    Value="{Binding Port}" />
									<CheckBox VerticalAlignment="Center"
									    Content="Open port on router (UPnP)"
									    IsChecked="{Binding UseNatPortMapping}"
									    IsEnabled="{Binding !IsHosting}" />
								</StackPanel>

								<TextBlock Margin="0,8,0,0" Text="Extra addresses (optional)" />
								<TextBox IsEnabled="{Binding !IsHosting}" Text="{Binding ExtraAddressesText}" Watermark="Public IP or DNS name" />

								<StackPanel Margin="0,8,0,0" Orientation="Horizontal">
									<Button Classes="Flat Accent" Command="{Binding StartHostingCommand}" Content="Start hosting" IsVisible="{Binding !IsHosting}" />
									<Button Command="{Binding StopHostingCommand}" Content="Stop hosting" IsVisible="{Binding IsHosting}" />
									<Button Command="{Binding RefreshSharedCommand}" IsVisible="{Binding IsHosting}" Content="Refresh" />
								</StackPanel>

								<TextBlock Margin="0,8,0,0" IsVisible="{Binding HostStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding HostStatus}" TextWrapping="Wrap" />
								<TextBlock Classes="hint" IsVisible="{Binding NatStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding NatStatus}" />
								<TextBlock Classes="hint" IsVisible="{Binding SharedSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding SharedSummary}" />

								<TextBlock Classes="header" Text="Invite code" />
								<Grid ColumnDefinitions="*,Auto,Auto">
									<TextBox IsReadOnly="True"
									    PasswordChar="•"
									    RevealPassword="{Binding #RevealInvite.IsChecked}"
									    Text="{Binding InviteCode}"
									    Watermark="Start hosting to get a code" />
									<ToggleButton Name="RevealInvite"
									    Grid.Column="1"
									    Margin="6,0,0,0"
									    Content="Show" />
									<Button Grid.Column="2"
									    Margin="6,0,0,0"
									    Classes="Flat Accent"
									    Command="{Binding CopyInviteCommand}"
									    Content="Copy" />
								</Grid>
								<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
									<TextBlock Classes="hint" VerticalAlignment="Center" Text="Keep it private." />
									<Button Margin="6,0,0,0" Padding="4,0" Command="{Binding RegenerateTokenCommand}" Content="New code" ToolTip.Tip="Old codes stop working" />
								</StackPanel>

								<TextBlock Classes="header" Text="Addresses" />
								<ItemsControl ItemsSource="{Binding Addresses}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:SyncAddressRow">
											<Grid Margin="0,1" ColumnDefinitions="80,200,*">
												<TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
												<SelectableTextBlock Grid.Column="1" Text="{Binding Address}" />
												<TextBlock Grid.Column="2" Foreground="{DynamicResource SukiLowText}" Text="{Binding Source}" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBlock Classes="header" Text="Activity" />
								<ListBox MaxHeight="180" ItemsSource="{Binding Activity}" />
							</StackPanel>
						</ScrollViewer>
					</TabItem>

					<!--  ============================ JOIN ============================  -->
					<TabItem Header="Join">
						<Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
								<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
								<TextBox PasswordChar="•"
								    RevealPassword="{Binding #RevealJoinInvite.IsChecked}"
								    Text="{Binding InviteInput}"
								    Watermark="BG3SYNC1-..." />
								<ToggleButton Name="RevealJoinInvite"
								    Grid.Column="1"
								    Margin="6,0,0,0"
								    Content="Show" />
								<Button Grid.Column="2"
								    Margin="6,0,0,0"
								    Classes="Flat Accent"
								    Command="{Binding ConnectCommand}"
								    Content="Connect" />
							</Grid>
							<SelectableTextBlock Grid.Row="1"
							    Margin="0,8,0,0"
							    Text="{Binding JoinStatus}"
							    TextWrapping="Wrap" />
							<TextBlock Grid.Row="2"
							    Margin="0,6,0,4"
							    FontWeight="SemiBold"
							    Text="{Binding PlanSummary}"
							    TextWrapping="Wrap" />

							<ListBox Grid.Row="3" ItemsSource="{Binding PlanRows}">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="vm:SyncPlanRow">
										<Grid ColumnDefinitions="110,*,90">
											<TextBlock FontWeight="SemiBold"
											    Foreground="{Binding StatusColor}"
											    Text="{Binding Status}" />
											<StackPanel Grid.Column="1">
												<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
												<TextBlock FontSize="11"
												    Foreground="{DynamicResource SukiLowText}"
												    Text="{Binding FileName}"
												    TextTrimming="CharacterEllipsis" />
											</StackPanel>
											<TextBlock Grid.Column="2"
											    HorizontalAlignment="Right"
											    Text="{Binding Size}" />
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

							<StackPanel Grid.Row="4" Margin="0,8,0,0">
								<CheckBox Content="Export to game" IsChecked="{Binding ExportToGame}" />
							</StackPanel>

							<StackPanel Grid.Row="5"
							    Margin="0,8,0,0"
							    IsVisible="{Binding IsSyncing}">
								<ProgressBar Height="8" Value="{Binding ProgressPercent}" />
								<TextBlock FontSize="12"
								    Text="{Binding ProgressText}"
								    TextTrimming="CharacterEllipsis" />
							</StackPanel>

							<StackPanel Grid.Row="6"
							    Margin="0,8,0,0"
							    Orientation="Horizontal">
								<Button Classes="Flat Accent" Command="{Binding SyncCommand}" Content="Sync now" IsVisible="{Binding HasPlan}" />
								<Button Command="{Binding CancelCommand}" Content="Cancel" />
								<Button Command="{Binding OpenBackupFolderCommand}" Content="Open backup folder" IsVisible="{Binding LastBackupFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
							</StackPanel>
						</Grid>
					</TabItem>
				</TabControl>
			</Panel>
				<suki:SukiToastHost Name="ToastHost" MaxToasts="4" Position="BottomLeft" />
		</Panel>
	</VisualLayerManager>
</Window>
