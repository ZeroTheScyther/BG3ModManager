<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>ModManager.Services</AssemblyName>
		<RootNamespace>ModManager</RootNamespace>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoUpdateViaGitHubRelease" />
		<PackageReference Include="System.Reactive" />
		<PackageReference Include="ReactiveUI" />
		<PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="ReactiveUI.Validation" />
		<PackageReference Include="DynamicData" />
		<PackageReference Include="Splat" />
		<PackageReference Include="Splat.DependencyInjection.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="System.IO.Abstractions" />
		<PackageReference Include="TextCopy" />
		<PackageReference Include="ZiggyCreatures.FusionCache" />
		<!-- Mod sync: UPnP / NAT-PMP port mapping -->
		<PackageReference Include="Mono.Nat" />
	</ItemGroup>

	<ItemGroup>
		<!-- Mod sync: Kestrel HTTPS server hosted inside the app -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\External\CrossSpeak\CrossSpeak\CrossSpeak.csproj" />
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>
</Project>